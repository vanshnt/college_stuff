# Q. 1 Create a Stack with following operations
# 1. Push
# 2. Pop
# 3. Display
# 4. Reverse String using Stack
# 5. Reverse Stack using another Stack



class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class Stack:
    def __init__(self):
        self.top = None

    def isempty(self):
        return self.top is None

    def push(self, data):
        new_node = Node(data)
        if self.isempty():
            self.top = new_node
        else:
            new_node.next = self.top
            self.top = new_node

    def pop(self):
        if self.isempty():
            print("Stack is Underflow")
            return None

        curr = self.top
        self.top = self.top.next
        return curr.data

    def print_stack(self):
        curr = self.top
        while curr is not None:
            print(curr.data, end=" ")
            curr = curr.next
        print()

    def reverse(self):
        curr = self.top
        new_stack = Stack()
        while curr is not None:
            new_stack.push(curr.data)
            curr = curr.next
        return new_stack


s = Stack()
s.push(5)
s.push(10)
s.push(15)
s.push(20)
s.push(25)
s.print_stack()
s.pop()
s.print_stack()

# Reversing a Stack using new Stack
new_stack = s.reverse()
new_stack.print_stack()

s = "HELLO"
stack = []

# Push characters into stack
for ch in s:
    stack.append(ch)

# Pop characters to reverse the string
rev = ""

while len(stack) > 0:
    rev += stack.pop()

print("Original String:", s)
print("Reversed String:", rev)
